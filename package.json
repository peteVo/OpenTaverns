{
  "name": "opentaverns",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w @opentaverns/server\" \"npm run dev -w @opentaverns/web\"",
    "build": "npm run build -w @opentaverns/hearthlands && npm run build -w @opentaverns/saigon-grid && npm run build -w @opentaverns/blackout && npm run build -w @opentaverns/web && npm run build -w @opentaverns/server",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/test-e2e.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "simulate": "node scripts/simulate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
